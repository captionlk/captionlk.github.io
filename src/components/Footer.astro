---
import { translations, type Locale } from '../i18n/translations';

interface Props {
  currentLocale: Locale;
}

const { currentLocale } = Astro.props;
const t = translations[currentLocale];
---

<footer class="mt-20 border-t border-[#EADBCE] dark:border-[#223B30] bg-[#FAF2EB] dark:bg-[#0E1713] py-12 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      
      {/* Brand & Mission */}
      <div class="flex flex-col items-center md:items-start text-center md:text-left">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-xl bg-gradient-to-tr from-[#1D4533] to-[#5E3122] flex items-center justify-center text-[#F9D2BA] text-xs font-extrabold shadow-xs">
            LK
          </div>
          <span class="font-extrabold text-base text-[#1D4533] dark:text-[#F7EAE0]">
            Caption<span class="text-[#5E3122] dark:text-[#F9D2BA]">LK</span>
          </span>
        </div>
        <p class="text-xs text-[#5E3122]/80 dark:text-[#F7EAE0]/70 mt-1 max-w-sm">
          {t.footerRights}
        </p>
      </div>

      {/* Quick Links */}
      <div class="flex flex-wrap items-center justify-center gap-6 text-xs text-[#5E3122] dark:text-[#F7EAE0]/80">
        <a 
          href={currentLocale === 'en' ? '/si/' : '/'} 
          class="hover:text-[#1D4533] dark:hover:text-[#F9D2BA] transition-colors font-sinhala font-medium"
        >
          {currentLocale === 'en' ? 'සිංහල අනුවාදය' : 'English Version'}
        </a>
        <a 
          href="https://buymeacoffee.com/kisharadilz" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-[#1D4533] dark:hover:text-[#F9D2BA] transition-colors font-bold flex items-center gap-1"
        >
          ☕ {t.supportDev}
        </a>
        <a 
          href="https://github.com/captionlk/captionlk.github.io" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-[#1D4533] dark:hover:text-[#F9D2BA] transition-colors font-medium"
        >
          GitHub Repository
        </a>
      </div>

    </div>

    {/* Bottom subtext */}
    <div class="mt-8 pt-8 border-t border-[#EADBCE]/60 dark:border-[#223B30]/60 flex flex-col sm:flex-row items-center justify-between text-[11px] text-[#5E3122]/60 dark:text-[#F7EAE0]/50 gap-3">
      <p>{t.madeWithLove}</p>
      <p>100% Zero-Server Privacy Guaranteed &bull; MIT Open Source</p>
    </div>
  </div>
</footer>
